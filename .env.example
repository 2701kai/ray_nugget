# Application Default Credentials stay outside the repository.
# Authenticate with: gcloud auth application-default login
PETE_GCP_PROJECT=your-company-project
PETE_GCP_LOCATION=eu
PETE_GCP_BUCKET=your-private-eu-audio-bucket
PETE_SPEECH_MODEL=chirp_3
PETE_SPEECH_LANGUAGES=de-DE,en-US
PETE_ALLOWED_ORIGIN=http://localhost:8081

# Browser preview only; the gateway binds to loopback and is not a public API.
EXPO_PUBLIC_PROCESSING_URL=http://127.0.0.1:8091
