{
  "name": "pete",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "expo start",
    "web": "bun run prepare:ocr && expo start --web --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "bun run prepare:ocr && expo export --platform web && bun scripts/prepare-pwa.ts",
    "preview": "bun scripts/preview.ts",
    "build:hosted": "bun scripts/build-hosted.ts",
    "deploy:hosting": "bun scripts/deploy-hosting.ts",
    "server:hosted": "bun server/hosted.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "test:e2e": "playwright test",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "bench:storage": "bun scripts/benchmark-storage.ts",
    "test:auth": "bunx firebase-tools@15.34.1 emulators:exec --only auth --project demo-pete-sso --config integration/firebase.json 'bun test ./integration/google-auth.test.ts'",
    "prepare:ocr": "bun scripts/prepare-ocr.ts",
    "server": "bun server/index.ts",
    "test:hosted": "playwright test --config playwright.hosted.config.ts",
    "eval:details": "bun scripts/evaluate-details.ts"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "idb": "8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/bun": "^1.4.4",
    "@types/react": "~19.3.0",
    "fake-indexeddb": "6.2.6",
    "typescript": "~6.0.3"
  }
}
